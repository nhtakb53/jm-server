<Window x:Class="JmServer.Launcher.Wpf.CreateCharacterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="서버 전용 캐릭터 생성"
        Width="560"
        Height="590"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="서버 전용 캐릭터 생성"
                       FontSize="24"
                       FontWeight="Bold" />
            <TextBlock x:Name="CapacityText"
                       Margin="0,7,0,0"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <StackPanel>
                <Label Content="캐릭터 이름" />
                <TextBox x:Name="NameTextBox"
                         MaxLength="15"
                         TextChanged="SelectionChanged" />
                <TextBlock x:Name="NameRuleText"
                           Margin="0,7,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />

                <Label Content="직업" Margin="0,18,0,0" />
                <ComboBox x:Name="ClassComboBox"
                          Padding="10,8"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="SelectionChanged" />
                <TextBlock x:Name="ClassDescriptionText"
                           Margin="0,7,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />

                <Border Margin="0,18,0,0"
                        Padding="14"
                        Background="#101216"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock x:Name="PresetDescriptionText"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="PresetPointsText"
                                   Margin="0,7,0,0"
                                   Foreground="{StaticResource AccentBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,18,0,0"
                           Foreground="{StaticResource WarningBrush}"
                           Text="호라드릭 큐브만 기본 지급됩니다. 장비는 게임에서 직접 획득하세요."
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           Text="상점 할인 참: 기드 일반 상점의 Gheed's Fortune 선택 카드 + 열쇠를 큐브에서 변환"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Margin="0,0,10,0" Click="CancelButton_Click" />
            <Button x:Name="CreateButton"
                    Content="서버에 생성"
                    Style="{StaticResource PrimaryButton}"
                    Click="CreateButton_Click" />
        </StackPanel>
    </Grid>
</Window>
