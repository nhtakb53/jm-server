<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>정만서버</AssemblyName>
    <RootNamespace>JmServer.Launcher.Wpf</RootNamespace>
    <Product>정만서버</Product>
    <Description>정만서버 Windows 그래픽 런처</Description>
    <ApplicationIcon>..\..\assets\branding\jm.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JmServer.Launcher\JmServer.Launcher.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\branding\jm.png" Link="Assets\jm.png" />
    <Content Include="..\..\docs\web\**\*"
             Link="guide\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
