<Window x:Class="JmServer.Launcher.Wpf.CreatePvpRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PK 방 만들기"
        Width="560"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="PK 방 만들기" FontSize="24" FontWeight="Bold" />
            <TextBlock x:Name="CharacterText"
                       Margin="0,7,0,0"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <StackPanel>
                <Label Content="친구에게 공개할 호스트 IPv4 주소" />
                <TextBox x:Name="HostAddressTextBox"
                         TextChanged="HostAddressTextBox_TextChanged" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="같은 LAN/VPN이면 해당 IPv4를, 인터넷 직결이면 포트포워딩된 공인 IPv4를 입력하세요."
                           TextWrapping="Wrap" />

                <Border Margin="0,18,0,0"
                        Padding="14"
                        Background="#101216"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="공개 게임 포트 · TCP 15571" FontWeight="SemiBold" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="런처가 공개 TCP 15571을 D2R의 로컬 포트로 중계합니다. D2RLoader 실행 후 게임에서 TCP/IP → 방 만들기를 선택하세요."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Margin="0,0,10,0" Click="CancelButton_Click" />
            <Button x:Name="CreateButton"
                    Content="방 만들고 실행"
                    Style="{StaticResource PrimaryButton}"
                    Click="CreateButton_Click" />
        </StackPanel>
    </Grid>
</Window>
