<Window x:Class="JmServer.Launcher.Wpf.DeletedCharactersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="캐릭터 휴지통"
        Width="650"
        Height="430"
        MinWidth="600"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="캐릭터 휴지통" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="삭제된 캐릭터와 동반 파일은 서버에 보존됩니다."
                       Margin="0,6,0,0"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
        <ListView Grid.Row="2"
                  x:Name="DeletedCharacterList"
                  Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  SelectionChanged="DeletedCharacterList_SelectionChanged">
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="이름" Width="180" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="직업" Width="150" DisplayMemberBinding="{Binding CharacterClass}" />
                    <GridViewColumn Header="삭제 시각" Width="220" DisplayMemberBinding="{Binding DeletedAt}" />
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PurgeButton"
                    Content="선택 영구 삭제"
                    Foreground="{StaticResource DangerBrush}"
                    Margin="0,0,10,0"
                    Click="PurgeButton_Click" />
            <Button x:Name="RestoreButton"
                    Content="선택 캐릭터 복구"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0"
                    Click="RestoreButton_Click" />
            <Button Content="닫기" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
