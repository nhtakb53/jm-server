<Window x:Class="JmServer.Launcher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="정만서버"
        Width="1280"
        Height="850"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="26,22,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="58" Height="58" CornerRadius="29" ClipToBounds="True">
                <Image Source="Assets/jm.png" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Eyebrow}" Text="JM PRIVATE PVP" />
                <TextBlock Text="정만서버" FontSize="27" FontWeight="Bold" Margin="0,2,0,0" />
                <TextBlock Text="서버 전용 캐릭터 · 안전한 체크아웃 · 인게임 장비 세팅"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource InsetBorder}" Padding="14,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="AccountText" Text="계정 미연결"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="EndpointText" Text="서버 설정 필요"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                   HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Button Content="사용 가이드" Style="{StaticResource CompactButton}"
                        Click="OpenGuideButton_Click" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="2" x:Name="MainTabs"
                    Background="Transparent" BorderThickness="0" Padding="0">
            <TabItem Header="캐릭터 플레이">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="3">
                        <Border Style="{StaticResource CardBorder}" Padding="16,13" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="SERVER" />
                                <TextBlock x:Name="ServerStatusText" Style="{StaticResource StatusValue}" Text="확인 전" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="16,13" Margin="7,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="GAME CLIENT" />
                                <TextBlock x:Name="ClientStatusText" Style="{StaticResource StatusValue}" Text="확인 전" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="16,13" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="SAFE RETURN" />
                                <TextBlock x:Name="RecoveryStatusText" Style="{StaticResource StatusValue}" Text="없음" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="350" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="내 캐릭터" />
                                        <TextBlock Text="서버에 저장된 캐릭터를 선택해 안전하게 플레이합니다."
                                                   Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="CreateCharacterButton" Content="+ 새 캐릭터"
                                                Style="{StaticResource CompactButton}" Margin="0,0,8,0"
                                                Click="CreateCharacterButton_Click" />
                                        <Button x:Name="RefreshButton" Content="새로고침"
                                                Style="{StaticResource CompactButton}" Click="RefreshButton_Click" />
                                    </StackPanel>
                                </Grid>
                                <ListView Grid.Row="2" x:Name="CharacterList"
                                          Background="{StaticResource InsetBrush}"
                                          Foreground="{StaticResource TextBrush}"
                                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                          SelectionChanged="CharacterList_SelectionChanged">
                                    <ListView.View>
                                        <GridView AllowsColumnReorder="False">
                                            <GridViewColumn Header="이름" Width="190" DisplayMemberBinding="{Binding Name}" />
                                            <GridViewColumn Header="직업" Width="150" DisplayMemberBinding="{Binding CharacterClass}" />
                                            <GridViewColumn Header="리비전" Width="90" DisplayMemberBinding="{Binding Revision}" />
                                            <GridViewColumn Header="상태" Width="220" DisplayMemberBinding="{Binding Status}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <Grid Grid.Row="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ManageCharacterButton" Content="캐릭터 관리"
                                                Style="{StaticResource CompactButton}" Margin="0,0,8,0"
                                                Click="ManageCharacterButton_Click" />
                                        <Button x:Name="RecoverButton" Content="복구 체크인"
                                                Style="{StaticResource CompactButton}" Margin="0,0,8,0"
                                                Click="RecoverButton_Click" />
                                        <Button x:Name="TrashButton" Content="휴지통"
                                                Style="{StaticResource DangerButton}" Padding="12,7"
                                                Click="TrashButton_Click" />
                                    </StackPanel>
                                    <Button x:Name="PlayButton" Content="선택 캐릭터 플레이"
                                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                            MinWidth="210" Click="PlayButton_Click" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource CardBorder}" Padding="18">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="QUICK START" />
                                    <TextBlock Text="플레이 순서" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,10" />
                                    <TextBlock Text="1  캐릭터 선택" Margin="0,0,0,6" />
                                    <TextBlock Text="2  플레이 버튼으로 체크아웃" Margin="0,0,0,6" />
                                    <TextBlock Text="3  게임 종료 후 자동 체크인" />
                                    <TextBlock Text="비정상 종료 시 복구 체크인을 사용하세요."
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="활동 기록" FontWeight="SemiBold" Margin="16,13,16,10" />
                                    <TextBox Grid.Row="1" x:Name="LogTextBox" IsReadOnly="True"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                             Background="{StaticResource InsetBrush}" Padding="14"
                                             FontFamily="Cascadia Mono,Consolas" FontSize="11.5" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="2인 PK 로비">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorder}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="290" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="친구와 PK" />
                                <TextBlock Text="방 예약과 외부 접속 주소는 서버가 공유하고, 전투는 D2R TCP/IP로 실행됩니다."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,4,20,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="PvpCharacterComboBox"
                                      Padding="10,8" DisplayMemberPath="Name" VerticalAlignment="Center"
                                      SelectionChanged="PvpCharacterComboBox_SelectionChanged" />
                            <Button Grid.Column="3" x:Name="RefreshPvpRoomsButton" Content="방 목록 새로고침"
                                    Style="{StaticResource CompactButton}" VerticalAlignment="Center"
                                    Click="RefreshPvpRoomsButton_Click" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                        <ListView x:Name="PvpRoomList" Background="{StaticResource InsetBrush}"
                                  Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                  SelectionChanged="PvpRoomList_SelectionChanged">
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Header="코드" Width="90" DisplayMemberBinding="{Binding RoomCode}" />
                                    <GridViewColumn Header="호스트" Width="135" DisplayMemberBinding="{Binding HostUsername}" />
                                    <GridViewColumn Header="캐릭터" Width="165" DisplayMemberBinding="{Binding HostCharacterName}" />
                                    <GridViewColumn Header="참가자" Width="135" DisplayMemberBinding="{Binding GuestUsername}" />
                                    <GridViewColumn Header="상태" Width="125" DisplayMemberBinding="{Binding Status}" />
                                    <GridViewColumn Header="접속 주소" Width="210" DisplayMemberBinding="{Binding Endpoint}" />
                                    <GridViewColumn Header="만료" Width="145" DisplayMemberBinding="{Binding ExpiresAt}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                    <Grid Grid.Row="4">
                        <Border Style="{StaticResource InsetBorder}" Padding="14,10" Margin="0,0,250,0">
                            <TextBlock x:Name="PvpStatusText" Text="PK 캐릭터와 방을 선택하세요."
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="CreatePvpRoomButton" Content="PK 방 만들기" Margin="0,0,8,0"
                                    Click="CreatePvpRoomButton_Click" />
                            <Button x:Name="JoinPvpRoomButton" Content="선택 방 참가"
                                    Style="{StaticResource PrimaryButton}" Click="JoinPvpRoomButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="설정 및 복구">
                <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="SECURE CONNECTION" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="서버 연결" Margin="0,4,0,0" />
                                <TextBlock Text="장치 토큰은 현재 Windows 사용자에게만 복호화되도록 저장됩니다."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,18" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="서버 주소" />
                                        <TextBox x:Name="ServerTextBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="포트" />
                                        <TextBox x:Name="PortTextBox" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="UseTlsCheckBox" Content="TLS 및 인증서 SHA-256 고정"
                                          IsChecked="True" IsEnabled="False" Foreground="{StaticResource TextBrush}"
                                          Margin="0,16,0,0" />
                                <Label Content="인증서 SHA-256" Margin="0,14,0,0" />
                                <TextBox x:Name="CertificateTextBox" />
                                <Label Content="장치 ID" Margin="0,14,0,0" />
                                <TextBox x:Name="DeviceIdTextBox" />
                                <Label Content="장치 토큰" Margin="0,14,0,0" />
                                <PasswordBox x:Name="TokenPasswordBox" />
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Content="연결 시험" Margin="0,0,8,0" Click="TestConnectionButton_Click" />
                                    <Button Content="설정 저장" Style="{StaticResource PrimaryButton}"
                                            Click="SaveSettingsButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="GAME RUNTIME" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="D2R 클라이언트" Margin="0,4,0,0" />
                                <TextBlock Text="D2R 3.2.92777 · D2RLoader 1.0.1-beta · 정만서버 모드 데이터"
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,18" />
                                <Label Content="D2R 설치 폴더" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="GameDirectoryTextBox" />
                                    <Button Grid.Column="2" Content="찾기" Style="{StaticResource CompactButton}"
                                            Click="BrowseGameButton_Click" />
                                </Grid>
                                <Label Content="D2RLoader 원본 ZIP" Margin="0,15,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LoaderArchiveTextBox" />
                                    <Button Grid.Column="2" Content="찾기" Style="{StaticResource CompactButton}"
                                            Click="BrowseLoaderButton_Click" />
                                </Grid>
                                <Grid Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="화면 모드" />
                                        <ComboBox x:Name="WindowModeComboBox" Padding="10,8" DisplayMemberPath="Label"
                                                  SelectionChanged="WindowModeComboBox_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="창 모드 해상도" />
                                        <ComboBox x:Name="ResolutionComboBox" Padding="10,8" DisplayMemberPath="Label" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="DisplayModeHelpText" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <WrapPanel Margin="0,20,0,0">
                                    <Button Content="설치 검증" Margin="0,0,8,8" Click="VerifyClientButton_Click" />
                                    <Button Content="설치 / 복구" Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,8,8" Click="PrepareClientButton_Click" />
                                    <Button Content="전리품 필터 복사" Margin="0,0,0,8"
                                            Click="CopyLootFilterButton_Click" />
                                </WrapPanel>
                                <Border Style="{StaticResource InsetBorder}" Margin="0,12,0,0">
                                    <TextBlock x:Name="SettingsStatusText" Text="설정을 확인한 뒤 저장하세요."
                                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar x:Name="BusyProgress" Height="3" IsIndeterminate="True"
                         Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="BusyText" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,0" />
                <Button x:Name="CancelButton" Content="작업 취소" Style="{StaticResource CompactButton}"
                        Visibility="Collapsed" Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
