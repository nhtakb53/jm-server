<Window x:Class="JmServer.Launcher.Wpf.CharacterManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="캐릭터 관리"
        Width="560"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="서버 전용 캐릭터 관리" FontSize="24" FontWeight="Bold" />
            <TextBlock x:Name="CharacterSummaryText"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="레벨" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="LevelText" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="힘 / 민첩" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="StrengthDexterityText" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="활력 / 마력" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="VitalityEnergyText" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                    <TextBlock Text="미사용 스탯" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="UnspentStatsText"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel>
                <TextBlock Text="이름 변경" FontWeight="SemiBold" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NameTextBox" Padding="10,8" MaxLength="15" />
                    <Button Grid.Column="2"
                            Content="이름 변경"
                            Click="RenameButton_Click" />
                </Grid>
                <TextBlock Margin="0,18,0,0"
                           Text="스탯 초기화는 지금까지 획득한 총 포인트를 유지하면서 직업 기본 능력치로 되돌립니다. 아이템과 스킬은 변경하지 않습니다."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Button Content="스탯 초기화"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Click="ResetStatsButton_Click" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="휴지통으로 이동"
                    Foreground="{StaticResource DangerBrush}"
                    Margin="0,0,10,0"
                    Click="DeleteButton_Click" />
            <Button Content="닫기" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
